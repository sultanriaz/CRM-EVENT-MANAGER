<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Send_Booking_Confirmation</fullName>
        <description>Sends a booking confirmation email to the member when a Class Booking is created.</description>
        <protected>false</protected>
        <recipients>
            <field>Contact__c</field>
            <type>contactLookup</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Booking_Confirmation</template>
    </alerts>
</Workflow>

<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Capacity_Range</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Capacity__c)), OR(Capacity__c &lt; 10, Capacity__c &gt; 1000))</errorConditionFormula>
    <errorDisplayField>Capacity__c</errorDisplayField>
    <errorMessage>Capacity must be between 10 and 1000.</errorMessage>
</ValidationRule>

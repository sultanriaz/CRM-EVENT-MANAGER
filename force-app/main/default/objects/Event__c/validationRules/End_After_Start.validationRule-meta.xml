<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_After_Start</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Start_Date_Time__c)), NOT(ISBLANK(End_Date_Time__c)), End_Date_Time__c &lt;= Start_Date_Time__c)</errorConditionFormula>
    <errorDisplayField>End_Date_Time__c</errorDisplayField>
    <errorMessage>End Date/Time must be after Start Date/Time.</errorMessage>
</ValidationRule>

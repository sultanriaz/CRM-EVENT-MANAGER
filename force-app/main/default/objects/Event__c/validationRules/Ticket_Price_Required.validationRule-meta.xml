<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Ticket_Price_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISPICKVAL(Venue__c, "Online")), ISBLANK(Ticket_Price__c))</errorConditionFormula>
    <errorDisplayField>Ticket_Price__c</errorDisplayField>
    <errorMessage>Ticket Price is required when the Venue is not Online.</errorMessage>
</ValidationRule>

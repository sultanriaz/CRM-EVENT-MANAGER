<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Event_Duration_Hours__c</fullName>
    <label>Event Duration (Hours)</label>
    <type>Number</type>
    <precision>6</precision>
    <scale>1</scale>
    <formula>IF(OR(ISBLANK(Start_Date_Time__c), ISBLANK(End_Date_Time__c)), NULL, (End_Date_Time__c - Start_Date_Time__c) * 24)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
</CustomField>

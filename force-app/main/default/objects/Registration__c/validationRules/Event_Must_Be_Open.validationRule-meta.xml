<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Event_Must_Be_Open</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISNEW(), OR(ISPICKVAL(Event__r.Status__c, "Completed"), ISPICKVAL(Event__r.Status__c, "Cancelled")))</errorConditionFormula>
    <errorDisplayField>Event__c</errorDisplayField>
    <errorMessage>You cannot register for an event that is Completed or Cancelled.</errorMessage>
</ValidationRule>

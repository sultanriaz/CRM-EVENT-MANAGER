    <formulas>
        <name>FormulaFirstName</name>
        <dataType>String</dataType>
        <expression>IF(FIND(&quot; &quot;, {!varMemberName}) &gt; 0, LEFT({!varMemberName}, FIND(&quot; &quot;, {!varMemberName}) - 1), {!varMemberName})</expression>
    </formulas>
    <formulas>
        <name>FormulaLastName</name>
        <dataType>String</dataType>
        <expression>IF(FIND(&quot; &quot;, {!varMemberName}) &gt; 0, MID({!varMemberName}, FIND(&quot; &quot;, {!varMemberName}) + 1, 100), &quot;Member&quot;)</expression>
    </formulas>

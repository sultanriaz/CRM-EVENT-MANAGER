<?xml version='1.0' encoding='utf-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Daily 11 PM in org default timezone: closes past events and updates society aggregates.</description>
    <interviewLabel>Daily Event Closer {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Daily Event Closer</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Mark_Completed</name>
        <label>Mark event completed</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <connector>
            <targetReference>Has_Society</targetReference>
        </connector>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <object>Event__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Society</name>
        <label>Persist society summary fields</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Society__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Completed_Events__c</field>
            <value>
                <elementReference>completedEvents</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Total_Attendees__c</field>
            <value>
                <elementReference>totalAttendees</elementReference>
            </value>
        </inputAssignments>
        <object>Society__c</object>
    </recordUpdates>
    <decisions>
        <name>Has_Ended</name>
        <label>Has the event ended?</label>
        <locationX>176</locationX>
        <locationY>60</locationY>
        <defaultConnectorLabel>Not ended</defaultConnectorLabel>
        <rules>
            <name>Past_End_Time</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.End_Date_Time__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue><elementReference>$Flow.CurrentDateTime</elementReference></rightValue>
            </conditions>
            <connector><targetReference>Mark_Completed</targetReference></connector>
            <label>Ended</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Society</name>
        <label>Related society present?</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnectorLabel>No society</defaultConnectorLabel>
        <rules>
            <name>Society_Attached</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Society__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Call_Stats</targetReference>
            </connector>
            <label>Society attached</label>
        </rules>
    </decisions>
    <subflows>
        <name>Call_Stats</name>
        <label>Calculate Society Stats</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <connector>
            <targetReference>Update_Society</targetReference>
        </connector>
        <flowName>Calculate_Society_Stats</flowName>
        <inputAssignments>
            <name>societyId</name>
            <value>
                <elementReference>$Record.Society__c</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>completedEvents</assignToReference>
            <name>completedEvents</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>totalAttendees</assignToReference>
            <name>totalAttendees</name>
        </outputAssignments>
    </subflows>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Has_Ended</targetReference>
        </connector>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <object>Event__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-10-09</startDate>
            <startTime>18:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <variables>
        <name>completedEvents</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>totalAttendees</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <status>Draft</status>
</Flow>

<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Workspace Switcher</masterLabel>
    <description>Switch between Fitness Hub and Campus Events Manager.</description>
    <targets>
        <target>lightning__UtilityBar</target>
        <target>lightning__HomePage</target>
        <target>lightning__AppPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__UtilityBar,lightning__HomePage,lightning__AppPage">
            <property name="currentApp" type="String" label="Current app API name" description="Use c__Community_Fitness_Wellness_Hub or c__Campus_Events_Manager" default="c__Community_Fitness_Wellness_Hub" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
